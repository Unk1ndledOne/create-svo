# Default: 2048
# Range: > 16
radar_range_limit = 2048
# Default: 1024
# Range: > 16
radar_default_range = 1024

	[cbc.cheat_cannon]
		enable = true
		# Default: 14
		# Range: > 1
		max_fire_rate = 14
		# Default: 20
		# Range: > 1
		rate_window = 20

[entity_radar]
	# Default: 2048
	# Range: > 16
	entity_range_limit = 2048
	# Default: 1024
	# Range: > 16
	player_range_limit = 1024
	show_player_names = true

[sable_engine]
	enable = true
	# Default: 4
	# Range: > 1
	max_rate = 4
	# Default: 20
	# Range: > 1
	rate_window = 20

[hologram]
	# Default: 256
	# Range: 16 ~ 1024
	max_width = 256
	# Default: 256
	# Range: 16 ~ 1024
	max_height = 256
	# Default: 8
	# Range: 1 ~ 64
	max_buffer_count = 8
	# Default: 8
	# Range: 1 ~ 64
	max_font_count = 8
	force_full_update = true
	# Default: 200
	# Range: 20 ~ 1200
	force_full_update_tick = 200
